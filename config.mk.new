RTPENGINE_VERSION := 26.2.0.0+0~mr26.2.0.0
export CFLAGS_DEFAULT :=  -O3 -flto=auto -ffat-lto-objects
export CPPFLAGS_DEFAULT := 
export LDFLAGS_DEFAULT :=  -flto=auto -fuse-linker-plugin
export CFLAGS_GLIB LDLIBS_GLIB
CFLAGS_GLIB := -I/usr/include/glib-2.0 -I/usr/lib64/glib-2.0/include 
LDLIBS_GLIB := -lglib-2.0 
export CFLAGS_GTHREAD LDLIBS_GTHREAD
CFLAGS_GTHREAD := -pthread -I/usr/include/glib-2.0 -I/usr/lib64/glib-2.0/include 
LDLIBS_GTHREAD := -lgthread-2.0 -pthread -lglib-2.0 
