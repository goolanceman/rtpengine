[Unit]
Description=rtpengine-recording TEST instance (12.5 rich-logs) - does NOT replace production
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib64
ExecStartPre=/bin/bash -c 'mkdir -p /var/spool/recording-test-12.5 /tmp/recordings-test-12.5; chmod -R a+rwx /var/spool/recording-test-12.5 /tmp/recordings-test-12.5 || true'
# Use bash wrapper: direct ExecStart of $HOME bins fails under SELinux (203/EXEC, user_home_t).
ExecStart=/bin/bash __ROOT__/start-recording.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
