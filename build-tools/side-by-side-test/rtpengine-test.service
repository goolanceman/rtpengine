[Unit]
Description=rtpengine TEST instance (12.5 rich-logs) - does NOT replace production
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib64
ExecStartPre=/bin/bash -c 'mkdir -p /var/spool/recording-test-12.5/{metadata,pcaps,tmp,wav} /tmp/recordings-test-12.5; chmod -R a+rwx /var/spool/recording-test-12.5 /tmp/recordings-test-12.5 || true'
ExecStartPre=/bin/bash -c 'modprobe xt_RTPENGINE 2>/dev/null || true; test -e /proc/rtpengine/control'
ExecStartPre=/bin/bash -c 'echo add 44 > /proc/rtpengine/control 2>/dev/null || true'
ExecStart=/bin/bash __ROOT__/start-daemon.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
