# RHEL/Rocky 8 build of rtpengine + rtpengine-recording (glibc 2.28 compatible).
# Output stage holds stripped binaries at /out/.

FROM rockylinux:8 AS build

ARG WITH_TRANSCODING=yes
ENV with_transcoding=${WITH_TRANSCODING}

RUN dnf -y install dnf-plugins-core epel-release \
  && dnf config-manager --set-enabled powertools \
  && dnf -y install https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-8.noarch.rpm \
  && dnf -y install \
    gcc gcc-c++ make pkgconfig git which file redhat-rpm-config \
    glib2-devel libcurl-devel openssl-devel pcre2-devel zlib-devel \
    hiredis-devel systemd-devel libnftnl-devel libpcap-devel \
    libevent-devel json-glib-devel mosquitto-devel \
    mariadb-connector-c-devel ncurses-devel libatomic \
    gperf perl-IPC-Cmd perl-podlators pandoc \
    libwebsockets-devel libjwt-devel opus-devel \
    iptables-devel \
  && if [ "${WITH_TRANSCODING}" = "yes" ]; then \
       dnf -y install ffmpeg-devel spandsp-devel; \
     fi \
  && dnf -y install gcc-toolset-13 gcc-toolset-13-libatomic-devel \
  && dnf clean all

# Prefer toolset-13 on EL8 (matches el/rtpengine.spec guidance)
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/opt/rh/gcc-toolset-13/root/usr/lib64
ENV PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/share/pkgconfig

WORKDIR /usr/src/rtpengine
COPY . .

# Drop GCC LTO flags; build from each component dir (same as top-level Dockerfile).
RUN sed -i \
  -e 's/ -flto=auto//g' \
  -e 's/ -ffat-lto-objects//g' \
  -e 's/ -fuse-linker-plugin//g' \
  utils/gen-common-flags \
  && make -C daemon -j"$(nproc)" rtpengine \
  && if [ "${WITH_TRANSCODING}" = "yes" ]; then \
       make -C recording-daemon -j"$(nproc)" rtpengine-recording; \
     fi \
  && mkdir -p /out \
  && strip -o /out/rtpengine daemon/rtpengine \
  && if [ -f recording-daemon/rtpengine-recording ]; then \
       strip -o /out/rtpengine-recording recording-daemon/rtpengine-recording; \
     fi \
  && file /out/* \
  && /out/rtpengine --version \
  && if [ -x /out/rtpengine-recording ]; then /out/rtpengine-recording --version; fi

FROM scratch AS binaries
COPY --from=build /out/ /out/
